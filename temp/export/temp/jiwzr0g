    <input type="checkbox" class="b3-switch fn__flex-center" value="2" >
</label><div class="fn__hr--small"></div><label class="fn__flex">
    <span class="fn__flex-1">H3</span>
    <input type="checkbox" class="b3-switch fn__flex-center" value="3" >
</label><div class="fn__hr--small"></div><label class="fn__flex">
    <span class="fn__flex-1">H4</span>
    <input type="checkbox" class="b3-switch fn__flex-center" value="4" >
</label><div class="fn__hr--small"></div><label class="fn__flex">
    <span class="fn__flex-1">H5</span>
    <input type="checkbox" class="b3-switch fn__flex-center" value="5" >
</label><div class="fn__hr--small"></div><label class="fn__flex">
    <span class="fn__flex-1">H6</span>
    <input type="checkbox" class="b3-switch fn__flex-center" value="6" >
</label></div>
        </div>
    </div>
    <div class="fn__flex" style="padding: 0 12px">
      <div class="fn__flex-1"></div>
