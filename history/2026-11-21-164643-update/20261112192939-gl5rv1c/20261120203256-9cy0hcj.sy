bleCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Presidensial"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"(dengan penguatan checks \u0026amp; balances)"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Perubahan (Amandemen) UUD 1945"},{"Type":"NodeText","Data":"dilakukan 4 kali (1999, 2000, 2001, 2002). Naskah UUD 1945 tidak diganti, melainkan disempurnakan."}]}]}]},{"ID":"20261120204942-do61qer","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261120204942-do61qer","updated":"20261120205234"},"Children":[{"Type":"NodeText","Data":"Poin Penting yang Sering Keluar di Ujian:"}]},{"ID":"20261120204942-wsf00n5","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20261120204942-wsf00n5","updated":"20261120204942"},"Children":[{"ID":"20261120204942-gouqbgo","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20261120204942-gouqbgo","updated":"20261120204942"},"Children":[{"ID":"20261120204942-dpg675u","Type":"NodeParagraph","Properties":{"id":"20261120204942-dpg675u","updated":"20261120204942"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Berapa kali pergantian UUD?"}]},{"ID":"20261120204942-aoxvn5z","Type":"NodeList","ListData":{},"Properties":{"id":"20261120204942-aoxvn5z","updated":"20261120204942"},"Children":[{"ID":"20261120204942-877aquj","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120204942-877aquj","updated":"20261120204942"},"Children":[{"ID":"20261120204942-ya92g00","Type":"NodeParagraph","Properties":{"id":"20261120204942-ya92g00","updated":"20261120204942"},"Children":[{"Type":"NodeText","Data":"Secara dokumen/naskah konstitusi, terjadi "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4 kali pergantian"},{"Type":"NodeText","Data":" (UUD 1945 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"\\rightarrow"},{"Type":"NodeText","Data":" Konstitusi RIS "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"\\rightarrow"},{"Type":"NodeText","Data":" UUDS 1950 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"\\rightarrow"},{"Type":"NodeText","Data":" kembali ke UUD 1945), dan "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4 kali amandemen"},{"Type":"NodeText","Data":" pada masa Reformasi."}]}]}]}]},{"ID":"20261120204942-vebgujv","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20261120204942-vebgujv","updated":"20261120204942"},"Children":[{"ID":"20261120204942-8nbu2xe","Type":"NodeParagraph","Properties":{"id":"20261120204942-8nbu2xe","updated":"20261120204942"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Kapan saja sistem pemerintahan Indonesia berbentuk Parlementer?"}]},{"ID":"20261120204942-a73rsrn","Type":"NodeList","ListData":{},"Properties":{"id":"20261120204942-a73rsrn","updated":"20261120204942"},"Children":[{"ID":"20261120204942-v1m8c3w","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120204942-v1m8c3w","updated":"20261120204942"},"Children":[{"ID":"20261120204942-rp4jlni","Type":"NodeParagraph","Properties":{"id":"20261120204942-rp4jlni","updated":"20261120204942"},"Children":[{"Type":"NodeText","Data":"Pada masa "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"UUD 1945 periode pertama"},{"Type":"NodeText","Data":" setelah keluarnya Maklumat 14 November 1945."}]}]},{"ID":"20261120204942-wgqxfko","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120204942-wgqxfko","updated":"20261120204942"},"Children":[{"ID":"20261120204942-imi01jm","Type":"NodeParagraph","Properties":{"id":"20261120204942-imi01jm","updated":"20261120204942"},"Children":[{"Type":"NodeText","Data":"Pada masa "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Konstitusi RIS 1949"},{"Type":"NodeText","Data":" (disebut "},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"parlementer semu"},{"Type":"NodeText","Data":" karena pengangkatan Perdana Menteri masih campur tangan Presiden, bukan murni pilihan parlemen)."}]}]},{"ID":"20261120204942-53jke5z","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120204942-53jke5z","updated":"20261120204942"},"Children":[{"ID":"20261120204942-cj2ilwe","Type":"NodeParagraph","Properties":{"id":"20261120204942-cj2ilwe","updated":"20261120204942"},"Children":[{"Type":"NodeText","Data":"Pada masa "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"UUDS 1950"},{"Type":"NodeText","Data":" (masa kejayaan demokrasi liberal/parlementer di mana kabinet sangat sering jatuh bangun)."}]}]}]}]},{"ID":"20261120204942-7vs6o6k","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20261120204942-7vs6o6k","updated":"20261120204942"},"Children":[{"ID":"20261120204942-1h1jgti","Type":"NodeParagraph","Properties":{"id":"20261120204942-1h1jgti","updated":"20261120204942"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Kapan saja sistem pemerintahan Indonesia berbentuk Presidensial?"}]},{"ID":"20261120204942-qorb2uc","Type":"NodeList","ListData":{},"Properties":{"id":"20261120204942-qorb2uc","updated":"20261120204942"},"Children":[{"ID":"20261120204942-oy4uabz","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120204942-oy4uabz","updated":"20261120204942"},"Children":[{"ID":"20261120204942-rfzl0im","Type":"NodeParagraph","Properties":{"id":"20261120204942-rfzl0im","updated":"20261120204942"},"Children":[{"Type":"NodeText","Data":"Awal kemerdekaan (18 Agustus 1945 – 14 November 1945)."}]}]},{"ID":"20261120204942-7erqaq0","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120204942-7erqaq0","updated":"20261120204942"},"Children":[{"ID":"20261120204942-340dr0u","Type":"NodeParagraph","Properties":{"id":"20261120204942-340dr0u","updated":"20261120204942"},"Children":[{"Type":"NodeText","Data":"Setelah Dekrit Presiden 5 Juli 1959 (masa Demokrasi Terpimpin \u0026 Orde Baru)."}]}]},{"ID":"20261120204942-xpq7c37","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120204942-xpq7c37","updated":"20261120204942"},"Children":[{"ID":"20261120204942-ar9n4q3","Type":"NodeParagraph","Properties":{"id":"20261120204942-ar9n4q3","updated":"20261120204942"},"Children":[{"Type":"NodeText","Data":"Masa Reformasi hingga sekarang (pasca-amandemen UUD 1945, sistem presidensial diperkuat dengan pemilihan presiden langsung oleh rakyat dan presiden tidak bisa membubarkan DPR)."}]}]}]}]}]},{"ID":"20261120205228-3uyo8z7","Type":"NodeParagraph","Properties":{"id":"20261120205228-3uyo8z7","updated":"20261120205228"}},{"ID":"20261120205229-5u4kmzt","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20261120205229-5u4kmzt","updated":"20261120205424"},"Children":[{"Type":"NodeText","Data":"Mengidentifikasi ciri khas Demokrasi Parlementer"}]},{"ID":"20261120205424-jaw25jo","Type":"NodeParagraph","Properties":{"id":"20261120205424-jaw25jo","updated":"20261120205424"},"Children":[{"Type":"NodeText","Data":"Ciri khas "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Demokrasi Parlementer"},{"Type":"NodeText","Data":" (yang diterapkan di Indonesia pada masa berlakunya ​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"UUDS 1950"},{"Type":"NodeText","Data":"​, sering disebut juga era Demokrasi Liberal) adalah sebagai berikut:"}]},{"ID":"20261120205424-lyyejoq","Type":"NodeList","ListData":{},"Properties":{"id":"20261120205424-lyyejoq","updated":"20261120205424"},"Children":[{"ID":"20261120205424-yhc6s5q","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120205424-yhc6s5q","updated":"20261120205424"},"Children":[{"ID":"20261120205424-3q6s9e3","Type":"NodeParagraph","Properties":{"id":"20261120205424-3q6s9e3","updated":"20261120205424"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Pemisahan Kepala Negara dan Kepala Pemerintahan:"},{"Type":"NodeText","Data":" Presiden (atau Raja) hanya berkedudukan sebagai "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"kepala negara"},{"Type":"NodeText","Data":" yang bersifat simbolis dan tidak dapat diganggu gugat, sedangkan "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"kepala pemerintahan"},{"Type":"NodeText","Data":" dipegang oleh seorang ​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Perdana Menteri"},{"Type":"NodeText","Data":"​."}]}]},{"ID":"20261120205424-ukbtvyt","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120205424-ukbtvyt","updated":"20261120205424"},"Children":[{"ID":"20261120205424-qqbmlrh","Type":"NodeParagraph","Properties":{"id":"20261120205424-qqbmlrh","updated":"20261120205424"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Kabinet Bertanggung Jawab kepada Parlemen (DPR):"},{"Type":"NodeText","Data":" Perdana Menteri beserta para menterinya bertanggung jawab penuh atas jalannya pemerintahan kepada parlemen, bukan kepada Presiden."}]}]},{"ID":"20261120205424-oz6wg33","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120205424-oz6wg33","updated":"20261120205424"},"Children":[{"ID":"20261120205424-r5uiefi","Type":"NodeParagraph","Properties":{"id":"20261120205424-r5uiefi","updated":"20261120205424"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Adanya Mosi Tidak Percaya ("},{"Type":"NodeTextMark","TextMarkType":"strong em","TextMarkTextContent":"Vote of No Confidence"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"):"},{"Type":"NodeText","Data":" Parlemen memiliki kekuasaan besar untuk mengawasi dan menjatuhkan kabinet kapan saja apabila kebijakan pemerintah dianggap tidak memuaskan melalui mosi tidak percaya. Akibatnya, pada masa UUDS 1950, kabinet sering berganti (7 kali pergantian kabinet dalam 9 tahun)."}]}]},{"ID":"20261120205424-dqqr7b9","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120205424-dqqr7b9","updated":"20261120205424"},"Children":[{"ID":"20261120205424-5m4s8e1","Type":"NodeParagraph","Properties":{"id":"20261120205424-5m4s8e1","updated":"20261120205424"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Sistem Multipartai:"},{"Type":"NodeText","Data":" Tumbuhnya banyak partai politik dengan berbagai aliran ideologi yang bersaing memperebutkan kursi di parlemen. Kabinet umumnya dibentuk melalui koalisi antarpartai karena tidak ada satu partai pun yang meraih suara mayoritas mutlak."}]}]},{"ID":"20261120205424-tc7727p","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120205424-tc7727p","updated":"20261120205424"},"Children":[{"ID":"20261120205424-qtl5wu0","Type":"NodeParagraph","Properties":{"id":"20261120205424-qtl5wu0","updated":"20261120205424"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Parlemen Dapat Dibubarkan oleh Kepala Negara:"},{"Type":"NodeText","Data":" Sebagai penyeimbang (mekanisme ​"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"checks and balances"},{"Type":"NodeText","Data":"​), Presiden atas usul Perdana Menteri berhak membubarkan parlemen apabila terjadi kebuntuan politik, yang kemudian diikuti dengan penyelenggaraan pemilu baru."}]}]},{"ID":"20261120205424-kv0m79t","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120205424-kv0m79t","updated":"20261120205424"},"Children":[{"ID":"20261120205424-e9hrhnu","Type":"NodeParagraph","Properties":{"id":"20261120205424-e9hrhnu","updated":"20261120205424"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Dominasi Badan Legislatif:"},{"Type":"NodeText","Data":" Kekuasaan legislatif (parlemen) jauh lebih kuat dibandingkan eksekutif karena Perdana Menteri dan menteri-menterinya umumnya berasal dari anggota parlemen yang memenangkan kursi terbanyak atau berhasil membentuk koalisi mayoritas."}]}]}]},{"ID":"20261120205630-7rj6j78","Type":"NodeParagraph","Properties":{"id":"20261120205630-7rj6j78","updated":"20261120205630"}},{"ID":"20261120205613-vwmaopc","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20261120205613-vwmaopc","updated":"20261120210011"},"Children":[{"Type":"NodeText","Data":"Penyebab dikeluarkannya Dekrit Presiden 5 Juli 1959"}]},{"ID":"20261120210011-70ear2n","Type":"NodeParagraph","Properties":{"id":"20261120210011-70ear2n","updated":"20261120210011"},"Children":[{"Type":"NodeText","Data":"Penyebab utama dikeluarkannya "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Dekrit Presiden 5 Juli 1959"},{"Type":"NodeText","Data":" oleh Presiden Soekarno (yang berkaitan dengan kisi-kisi ​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Soal No. 4, 8, 13, 14, dan 15"},{"Type":"NodeText","Data":"​) terbagi menjadi penyebab utama (langsung) dan penyebab pendukung:"}]},{"ID":"20261120210011-guyhnj0","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261120210011-guyhnj0","updated":"20261120210011"},"Children":[{"Type":"NodeText","Data":"1. Penyebab Utama (Langsung): Kegagalan Badan Konstituante"}]},{"ID":"20261120210011-sw1z9p4","Type":"NodeList","ListData":{},"Properties":{"id":"20261120210011-sw1z9p4","updated":"20261120210011"},"Children":[{"ID":"20261120210011-9s3uik1","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120210011-9s3uik1","updated":"20261120210011"},"Children":[{"ID":"20261120210011-0hy0vuj","Type":"NodeParagraph","Properties":{"id":"20261120210011-0hy0vuj","updated":"20261120210011"},"Children":[{"Type":"NodeText","Data":"Badan Konstituante hasil Pemilu 1955 bertugas menyusun UUD baru untuk menggantikan ​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"UUDS 1950"},{"Type":"NodeText","Data":"​."}]}]},{"ID":"20261120210011-w45v377","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120210011-w45v377","updated":"20261120210011"},"Children":[{"ID":"20261120210011-rz29tou","Type":"NodeParagraph","Properties":{"id":"20261120210011-rz29tou","updated":"20261120210011"},"Children":[{"Type":"NodeText","Data":"Namun, hingga tahun 1959, Konstituante gagal menyepakati dasar negara akibat perdebatan ideologis yang berlarut-larut antara kelompok nasionalis/sekuler (mempertahankan Pancasila) dan kelompok Islam (mengusulkan Islam sebagai dasar negara/Piagam Jakarta)."}]}]},{"ID":"20261120210011-5r9bpt3","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120210011-5r9bpt3","updated":"20261120210011"},"Children":[{"ID":"20261120210011-cr87g14","Type":"NodeParagraph","Properties":{"id":"20261120210011-cr87g14","updated":"20261120210011"},"Children":[{"Type":"NodeText","Data":"Presiden Soekarno kemudian mengusulkan agar Indonesia kembali ke ​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"UUD 1945"},{"Type":"NodeText","Data":"​, tetapi melalui tiga kali pemungutan suara (​"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"voting"},{"Type":"NodeText","Data":"​) di Konstituante, usulan tersebut tidak pernah mencapai kuorum (2/3 suara dari jumlah anggota yang hadir), diikuti dengan aksi boikot sidang oleh sejumlah anggota."}]}]}]},{"ID":"20261120210011-735w91z","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261120210011-735w91z","updated":"20261120210100"},"Children":[{"Type":"NodeText","Data":"2. Penyebab Pendukung (Situasi Politik \u0026 Keamanan)"}]},{"ID":"20261120210011-i79grro","Type":"NodeList","ListData":{},"Properties":{"id":"20261120210011-i79grro","updated":"20261120210011"},"Children":[{"ID":"20261120210011-1nzzzvq","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120210011-1nzzzvq","updated":"20261120210011"},"Children":[{"ID":"20261120210011-r41mepe","Type":"NodeParagraph","Properties":{"id":"20261120210011-r41mepe","updated":"20261120210011"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Ketidakstabilan Politik (Jatuh Bangunnya Kabinet):"},{"Type":"NodeText","Data":" Penerapan sistem parlementer dengan banyak partai menyebabkan kabinet sering bubar akibat mosi tidak percaya (terjadi 7 kali pergantian kabinet dalam kurun waktu 1950–1959), sehingga program pembangunan pemerintah tidak berjalan."}]}]},{"ID":"20261120210011-3tcxx49","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120210011-3tcxx49","updated":"20261120210011"},"Children":[{"ID":"20261120210011-bo8apea","Type":"NodeParagraph","Properties":{"id":"20261120210011-bo8apea","updated":"20261120210011"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Munculnya Gerakan Separatisme dan Pemberontakan Daerah:"},{"Type":"NodeText","Data":" Situasi politik pusat yang kacau memicu ketegangan pusat-daerah hingga pemberontakan bersenjata di berbagai wilayah (seperti DI/TII, PRRI/Permesta, dan RMS) yang mengancam keutuhan NKRI."}]}]},{"ID":"20261120210011-3c5g2ye","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261120210011-3c5g2ye","updated":"20261120210011"},"Children":[{"ID":"20261120210011-r86rrr1","Type":"NodeParagraph","Properties":{"id":"20261120210011-r86rrr1","updated":"20261120210011"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Krisis Ekonomi:"},{"Type":"NodeText","Data":" Kondisi keamanan yang tidak stabil dan pergantian kabinet yang terlalu cepat menyebabkan inflasi tinggi dan pembangunan ekonomi terbengkalai."}]}]}]},{"ID":"20261120210059-m6sdnk2","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20261120210059-m6sdnk2","updated":"20261121164556"},"Children":[{"Type":"NodeText","Data":"Penyimpangan pada praktik Demokrasi Terpimpin"}]},{"ID":"20261121164549-68s3ctm","Type":"NodeParagraph","Properties":{"id":"20261121164549-68s3ctm","updated":"20261121164549"},"Children":[{"Type":"NodeText","Data":"Pada masa "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Demokrasi Terpimpin"},{"Type":"NodeText","Data":" (1959–1966), kekuasaan negara terpusat pada Presiden Soekarno sehingga memunculkan berbagai penyimpangan terhadap Pancasila dan UUD 1945 (materi utama untuk ​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Soal No. 5"},{"Type":"NodeText","Data":"​):"}]},{"ID":"20261121164549-foj8j2m","Type":"NodeList","ListData":{},"Properties":{"id":"20261121164549-foj8j2m","updated":"20261121164549"},"Children":[{"ID":"20261121164549-06p9aza","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261121164549-06p9aza","updated":"20261121164549"},"Children":[{"ID":"20261121164549-qm3abfb","Type":"NodeParagraph","Properties":{"id":"20261121164549-qm3abfb","updated":"20261121164549"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Pengangkatan Presiden Seumur Hidup:"},{"Type":"NodeText","Data":" Melalui Ketetapan MPRS No. III/MPRS/1963, Ir. Soekarno ditetapkan sebagai presiden seumur hidup. Hal ini melanggar Pasal 7 UUD 1945 (sebelum amandemen) yang membatasi masa jabatan presiden selama 5 tahun."}]}]},{"ID":"20261121164549-fgveqks","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261121164549-fgveqks","updated":"20261121164549"},"Children":[{"ID":"20261121164549-kqcnwi7","Type":"NodeParagraph","Properties":{"id":"20261121164549-kqcnwi7","updated":"20261121164549"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Pembubaran DPR Hasil Pemilu 1955:"},{"Type":"NodeText","Data":" Presiden membubarkan DPR pada tahun 1960 karena menolak RAPBN yang diajukan pemerintah, kemudian membentuk DPR-GR (Gotong Royong) yang anggotanya ditunjuk langsung oleh Presiden. Padahal menurut UUD 1945, Presiden tidak berwenang membubarkan DPR."}]}]},{"ID":"20261121164549-cidedml","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261121164549-cidedml","updated":"20261121164549"},"Children":[{"ID":"20261121164549-sjsrtgx","Type":"NodeParagraph","Properties":{"id":"20261121164549-sjsrtgx","updated":"20261121164549"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Pimpinan Lembaga Negara Dijadikan Menteri:"},{"Type":"NodeText","Data":" Ketua MPRS, Ketua DPR-GR, Ketua MA, dan Wakil Ketua DPA diangkat menjadi menteri negara sehingga berada di bawah kendali Presiden. Hal ini menghapus pemisahan kekuasaan (​"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"trias politica"},{"Type":"NodeText","Data":"​) dan melemahkan pengawasan terhadap pemerintah."}]}]},{"ID":"20261121164549-guah0kp","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261121164549-guah0kp","updated":"20261121164549"},"Children":[{"ID":"20261121164549-ebwa7yp","Type":"NodeParagraph","Properties":{"id":"20261121164549-ebwa7yp","updated":"20261121164549"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Pembentukan Lembaga Negara Sementara:"},{"Type":"NodeText","Data":" Presiden membentuk MPRS dan DPAS melalui Penetapan Presiden (bukan melalui pemilu/undang-undang) dengan anggota yang diangkat dan diberhentikan langsung oleh Presiden."}]}]},{"ID":"20261121164549-9ew5bw8","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261121164549-9ew5bw8","updated":"20261121164549"},"Children":[{"ID":"20261121164549-3p2lqjo","Type":"NodeParagraph","Properties":{"id":"20261121164549-3p2lqjo","updated":"20261121164549"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Pidato Presiden Dijadikan GBHN:"},{"Type":"NodeText","Data":" Pidato kenegaraan Presiden 17 Agustus 1959 berjudul "},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"\"Penemuan Kembali Revolusi Kita\""},{"Type":"NodeText","Data":" (Manipol) ditetapkan sebagai Garis-Garis Besar Haluan Negara (GBHN), padahal penyusunan GBHN seharusnya merupakan wewenang MPR."}]}]},{"ID":"20261121164549-1gyrniy","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261121164549-1gyrniy","updated":"20261121164549"},"Children":[{"ID":"20261121164549-nh5twga","Type":"NodeParagraph","Properties":{"id":"20261121164549-nh5twga","updated":"20261121164549"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Penerapan Konsep Nasakom:"},{"Type":"NodeText","Data":" Penggabungan paham Nasionalis, Agama, dan Komunis memberi ruang luas bagi perkembangan PKI, yang bertentangan dengan nilai-nilai Pancasila."}]}]},{"ID":"20261121164549-xa42ew0","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20261121164549-xa42ew0","updated":"20261121164549"},"Children":[{"ID":"20261121164549-8kqdbas","Type":"NodeParagraph","Properties":{"id":"20261121164549-8kqdbas","updated":"20261121164549"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Penyimpangan Politik Luar Negeri:"},{"Type":"NodeText","Data":" Indonesia meninggalkan politik bebas aktif dengan membentuk poros Jakarta–Peking–Pyongyang (condong ke blok komunis), berkonfrontasi dengan Malaysia, serta keluar dari keanggotaan PBB pada 1965."}]}]}]},{"ID":"20261121164549-3108yet","Type":"NodeParagraph","Properties":{"id":"20261121164549-3108yet","updated":"20261121164549"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Ringkasan Hafalan Cepat untuk Ujian:"},{"Type":"NodeText","Data":"Jika muncul soal pilihan ganda tentang penyimpangan Demokrasi Terpimpin, cari opsi yang berkaitan dengan ​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"pemusatan kekuasaan di tangan presiden"},{"Type":"NodeText","Data":"​, terutama:"}]},{"ID":"20261121164549-loj6zfj","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20261121164549-loj6zfj","updated":"20261121164549"},"Children":[{"ID":"20261121164549-74l12yn","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20261121164549-74l12yn","updated":"20261121164549"},"Children":[{"ID":"20261121164549-afuq4bq","Type":"NodeParagraph","Properties":{"id":"20261121164549-afuq4bq","updated":"20261121164549"},"Children":[{"Type":"NodeText","Data":"Presiden diangkat seumur hidup (Tap MPRS No. III/MPRS/1963)."}]}]},{"ID":"20261121164549-9887b5o","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20261121164549-9887b5o","updated":"20261121164549"},"Children":[{"ID":"20261121164549-9p49dei","Type":"NodeParagraph","Properties":{"id":"20261121164549-9p49dei","updated":"20261121164549"},"Children":[{"Type":"NodeText","Data":"Presiden membubarkan DPR hasil Pemilu 1955 dan membentuk DPR-GR."}]}]},{"ID":"20261121164549-i0052tq","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20261121164549-i0052tq","updated":"20261121164549"},"Children":[{"ID":"20261121164549-3ulfatn","Type":"NodeParagraph","Properties":{"id":"20261121164549-3ulfatn","updated":"20261121164549"},"Children":[{"Type":"NodeText","Data":"Pimpinan lembaga tinggi/tertinggi negara dijadikan pembantu presiden (menteri)."}]}]}]},{"ID":"20261121164555-ycuu5ky","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20261121164555-ycuu5ky","updated":"20261121164556"}}]}